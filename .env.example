# ---------------------------------------------------------------------------
# Copy to .env and fill in. Required values are marked (required).
# ---------------------------------------------------------------------------

# PostgreSQL (Neon / Supabase). (required)
# Pooled URL for the running app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) URL for Prisma migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# NextAuth v5 secret — generate: openssl rand -base64 32  (required)
AUTH_SECRET=""

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only email login fallback. MUST be "false" (or unset) in production.
ENABLE_DEV_LOGIN="false"

# OpenRouter API key from https://openrouter.ai/keys
# If empty, the app degrades gracefully to built-in wellness guidance.
OPENROUTER_API_KEY=""

# Public base URL of the deployment. (required)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set automatically by Vercel — do not set manually.
# VERCEL_ENV="production"
